# Local development variables for Cloudflare Workers.
# Copy to `.dev.vars` (gitignored) — it is read by BOTH `yarn dev` (nitro runs
# through the Cloudflare dev emulation) and `yarn worker:dev` (wrangler dev).
# Production equivalents: `wrangler secret put <NAME>` for the SECRET values below
# and the `vars` block of wrangler.jsonc for the non-secret ones. Never commit a
# real value, and never put a real KV namespace id here — those live in
# wrangler.jsonc (`previews.kv_namespaces` = preview, `env.production.kv_namespaces`
# = production; local `wrangler dev` uses Miniflare's local KV, so nothing has to
# be created for local work).
#
# The plain names below are read first. The NUXT_-prefixed runtimeConfig
# equivalents exist only for the keys defined in nuxt.config.ts (NUXT_GITHUB_TOKEN
# and NUXT_GITHUB_* for `runtimeConfig.github`); the others (APP_KEYS,
# GITHUB_OWNER_LOGIN, GITHUB_OAUTH_TOKEN_URL, DEEPLX_URL, DEEPLX_TOKEN) are read
# from the bindings / process.env only and have no NUXT_ form. See the "GitHub
# tokens" section of README.md and MIGRATION.md for how the values are used.

# --- GitHub data access ---

# SECRET. Fallback token for the GitHub GraphQL API, used only when neither the
# signed-in user's own token nor the owner's stored OAuth token is available. A
# classic PAT needs no scopes (or `public_repo`) for public data, but some
# organisations reject it outright — that is what the OAuth user token below is
# for. A fine-grained PAT must be scoped to public repositories read-only AND
# expire within 366 days, otherwise organisations such as 1stG reject it.
GITHUB_TOKEN=

# NOT secrets. The repository whose issues are the articles.
GITHUB_REPOSITORY_OWNER=JounQin
GITHUB_REPOSITORY_NAME=blog
# `user` or `organization`; picks the `user(...)` / `organization(...)` query.
GITHUB_REPOSITORY_OWNER_TYPE=user

# NOT a secret. The maintainer's own GitHub *user* login. Every sign-in asks for
# `read:org read:user`; when this login signs in, the callback stores its OAuth
# token in the BLOG_OAUTH KV namespace, and that token then serves anonymous
# visitors (and is the fallback for a signed-in user whose own token cannot read
# an organisation). Defaults to the app owner above. The entry pins that account's
# numeric GitHub id, so changing this login neither uses nor overwrites it; moving
# the blog to another account on purpose means deleting the KV key first, then
# signing in as the new owner. No separate bootstrap secret exists:
# `OWNER_LOGIN_SECRET` was removed because it only gated those scopes.
# GITHUB_OWNER_LOGIN=JounQin

# --- sessions ---

# SECRET, comma separated; the first key signs the session cookie, all of them
# verify it.
APP_KEYS=dev-key-1,dev-key-2

# --- GitHub OAuth app (login button) ---

# NOT a secret: it is public in the authorize URL.
GITHUB_CLIENT_ID=
# SECRET.
GITHUB_CLIENT_SECRET=
# NOT a secret. Optional: when empty, /api/login derives it from the origin of the
# incoming request — previews rely on that, together with a wildcard redirect URI
# in the GitHub app settings.
GITHUB_OAUTH_CALLBACK=http://localhost:3000/api/oauth

# --- labels / filtering (NOT secrets) ---

# labels hidden from the article list / categories
GITHUB_EXCLUDED_LABELS=dependencies,feature,flag,greenkeeper,PR: draft,PR: merged,PR: partially-approved,PR: reviewed-approved,PR: reviewed-changes-requested,PR: unreviewed,security
# repositories whose items are filtered out of the pulse page
GITHUB_EXCLUDED_REPOSITORY_OWNERS=

# --- translations ---

# No configuration is needed: @deeplx/core uses DeepL's free endpoints. Optional
# fallback when @deeplx/core fails (4xx/5xx) or echoes a chunk unchanged, tried
# once against a self-hosted DLX (https://github.com/OwO-Network/DLX); the DLX
# answers with a different client profile, so it can still translate a chunk the
# library echoed. DEEPLX_URL is NOT a secret; DEEPLX_TOKEN is SECRET.
# DEEPLX_URL=https://<your-dlx-host>
# DEEPLX_TOKEN=

# --- optional overrides (self-hosted GitHub / local stub servers), NOT secrets ---

# GITHUB_API_URL=https://api.github.com/graphql
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token

# The legacy env.js also defined DEBUG / PARSER_NO_WATCH / TS_NODE_FILES for the
# old ts-node + nodemon + eslint 8 toolchain; the Nuxt stack does not use them.
