{
  "name": "@1stg/blog",
  "version": "0.0.0",
  "description": "a Blog system built on GitHub GraphQL API, Nuxt 4 SSR on Cloudflare Workers",
  "repository": "git@github.com:JounQin/blog.git",
  "author": "JounQin <admin@1stg.me>",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "deploy": "wrangler deploy",
    "worker:dev": "wrangler dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "nuxt prepare && simple-git-hooks",
    "typecheck": "nuxt prepare && tsc --noEmit -p .nuxt/tsconfig.app.json",
    "typecheck:server": "nuxt prepare && tsc --noEmit -p .nuxt/tsconfig.server.json"
  },
  "dependencies": {
    "@deeplx/core": "^0.2.2",
    "date-fns": "^4",
    "github-markdown-css": "^5.4.0",
    "invert-color": "^2.0.0",
    "nuxt": "^4",
    "vue": "^3",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@1stg/app-config": "^15.0.0",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^20.9.0",
    "@types/prettier": "^2.7.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "bootstrap": "^5.3.2",
    "commitlint": "^18.4.2",
    "eslint": "^9",
    "font-awesome": "^4.7.0",
    "lint-staged": "^13.3.0",
    "postcss-pxtorem": "^6.0.0",
    "prettier": "^2.8.8",
    "sass": "^1.105.1",
    "simple-git-hooks": "^2.9.0",
    "typeface-lato": "^1.1.13",
    "typescript": "^6.0.3",
    "wrangler": "^4"
  },
  "browserslist": [
    "extends @1stg/browserslist-config/modern"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "renovate": {
    "extends": [
      "@1stg"
    ]
  }
}
