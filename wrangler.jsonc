{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // KV namespace holding the maintainer's OAuth user token, so the GitHub-data
  // routes (`/api/about`, ...) can use it for anonymous renders too. The code
  // feature-detects the binding: without it the Worker keeps using GITHUB_TOKEN.
  //
  // The binding is declared per deploy path, never at the top level, because
  // that is where each path actually reads it:
  // - non-production / preview versions (`wrangler versions upload`, and the
  //   Cloudflare dashboard's preview Bindings page) read the `previews` block;
  // - production (`wrangler deploy --env production`) reads `env.production`.
  // A top-level `kv_namespaces` is read by neither path, so declaring one there
  // only produced a misleading duplicate that the deployed versions ignored.
  //
  // There is deliberately no dev namespace: `wrangler dev` (and `nuxt dev`'s
  // Cloudflare emulation) uses Miniflare's local KV, so local runs never touch
  // either deployed namespace.
  //
  // This file is the source of truth: a binding that exists only in the
  // Cloudflare dashboard is removed by the next deploy.
  "env": {
    // `name: "blog"` keeps this environment on the `blog` Worker instead of the
    // default `blog-production`. Bindings are not inherited, so `BLOG_OAUTH` is
    // declared here with the production namespace id; Production's Deploy
    // command must be `yarn deploy` (`wrangler deploy --env production`).
    "production": {
      "name": "blog",
      "kv_namespaces": [
        { "binding": "BLOG_OAUTH", "id": "f91ef4516759457ea7dee339b90471e2" },
      ],
    },
  },
  // `previews` is what non-production / Workers Builds preview versions read
  // (`wrangler versions upload`), and it is the shape the Cloudflare dashboard's
  // preview Bindings page generates. Assets, compatibility settings and
  // migrations still live at the top level. Keeping the app constants out of
  // `vars` is why nothing else has to be duplicated here --
  // GITHUB_REPOSITORY_OWNER / _NAME / _OWNER_TYPE have their defaults in
  // nuxt.config.ts (runtimeConfig.github) and are only overridden when an
  // environment variable is set.
  "previews": {
    "kv_namespaces": [
      { "binding": "BLOG_OAUTH", "id": "6c39022c31e5476980a52f0c55f3f947" },
    ],
  },
}
