{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // No `vars` on purpose: GITHUB_REPOSITORY_OWNER / _NAME / _OWNER_TYPE are app
  // constants, not per-environment configuration -- their defaults live in
  // nuxt.config.ts (runtimeConfig.github) and are used when no environment
  // variable overrides them. Without top-level `vars` a `previews` block is not
  // required either, so nothing has to be duplicated per environment. If a value
  // ever needs to differ per environment, add `vars` + a matching `previews.vars`.
}
