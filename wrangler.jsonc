{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // KV namespace holding the maintainer's OAuth user token, so the GitHub-data
  // routes (`/api/about`, ...) can use it for anonymous renders too. The code
  // feature-detects the binding: without it the Worker keeps using GITHUB_TOKEN.
  //
  // The top level is **production**, so it points at the production namespace:
  // a bare `wrangler deploy` uses it. There is deliberately no `env.<name>`
  // block -- a Wrangler environment would create a separately named Worker,
  // which is not wanted here.
  "kv_namespaces": [
    { "binding": "BLOG_OAUTH", "id": "f91ef4516759457ea7dee339b90471e2" },
  ],
  // Worker Previews do not inherit production settings, so the preview namespace
  // is declared here for `wrangler preview` (branch/PR Previews) -- the only
  // branch-isolated path. The dashboard's Settings -> Bindings -> Previews Base
  // panel generates this shape and warns that its changes must be copied back
  // here. Assets, compatibility settings and migrations stay at the top level.
  // (Keeping the app constants out of `vars` is why nothing else has to be
  // duplicated here -- GITHUB_REPOSITORY_OWNER / _NAME / _OWNER_TYPE have their
  // defaults in nuxt.config.ts (runtimeConfig.github) and are only overridden
  // when an environment variable is set.)
  //
  // Note: `wrangler versions upload` only creates a Version URL that uses
  // **production** resources; Cloudflare documents it as not suitable for branch
  // or pull-request testing, so real branch previews must go through Previews.
  //
  // There is deliberately no dev namespace: `wrangler dev` (and `nuxt dev`'s
  // Cloudflare emulation) uses Miniflare's local KV, so local runs never touch
  // either deployed namespace.
  //
  // This file is the source of truth: a binding that exists only in the
  // Cloudflare dashboard is removed by the next deploy.
  "previews": {
    "kv_namespaces": [
      { "binding": "BLOG_OAUTH", "id": "6c39022c31e5476980a52f0c55f3f947" },
    ],
  },
}
